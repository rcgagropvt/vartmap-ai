Set-Content -Path ".gitignore" -Value @"
node_modules/
.env
*.log
.DS_Store
__pycache__/
"@

# Remove node_modules from git tracking (keeps files locally)
git rm -r --cached services/whatsapp-gateway/node_modules

# Stage everything
git add .
git commit -m "remove node_modules from git, add gitignore"

# Push
git push